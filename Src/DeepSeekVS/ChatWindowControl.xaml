<UserControl x:Class="DeepSeekVS.ChatWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeepSeekVS">
    
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- История чата -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChatHistory">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="10" CornerRadius="10" 
                                Background="{Binding BubbleBackground}" 
                                HorizontalAlignment="{Binding Alignment}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Content}"
                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Индикатор набора -->
        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="{Binding IsLoading}" 
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Поле ввода -->
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox" AcceptsReturn="True" 
                     VerticalScrollBarVisibility="Auto" 
                     KeyDown="InputBox_KeyDown"/>

            <Button Grid.Column="1" Content="Send" Margin="5,0,0,0" 
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</UserControl>